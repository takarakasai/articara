/target
/ref
/.claude
/log
/MUJOCO_LOG.TXT
# `sample/` was moved out of this repo in 7229b82 (it lives as a
# separate fork now). Local clones / experiments may leave a `sample/`
# directory in the working tree — keep it out of `git status` noise.
/sample

# `models/` holds locally-downloaded robot assets (Menagerie sparse
# checkouts, internal experiments, etc.) that are NOT versioned here —
# except `models/unitree_go2/`, which is the shared `go2-model` git
# submodule (the `examples/go2_*.rs` scripts expect it at that path).
/models/*
!/models/unitree_go2

# Rendered videos: large binaries, regenerate with tools/render_namiashi.py
videos/

# Python tool bytecode cache (tools/ has a handful of render/analysis scripts
# alongside the Rust crate).
__pycache__/

# Generated IsaacLab USD import output (tests/fixtures/namiashi/usd/) --
# regenerate via the URDF->USD conversion pipeline; requires an IsaacLab
# environment, so it is not portable as a plain git blob the way the
# source URDF/.misa fixtures are.
tests/fixtures/namiashi/usd/
